{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@chrona/domain": ["../packages/domain/src/index.ts"],
      "@chrona/domain/*": ["../packages/domain/src/*"],
      "@/domain/*": ["../packages/domain/src/*"],
      "@app-data/*": ["../src/data/*"]
    }
  },
  "include": ["src", "../packages/domain/src"]
}
