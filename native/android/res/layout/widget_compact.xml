<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@color/chrona_widget_bg"
    android:padding="12dp">
    <LinearLayout
        android:id="@+id/compact_next_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/compact_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chrona_widget_accent"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/compact_next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/chrona_widget_text"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
    <TextView
        android:id="@+id/compact_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/chrona_widget_sub"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
